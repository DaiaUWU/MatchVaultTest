
@model IEnumerable<MatchVault.Models.Match>

@{
    ViewData["Title"] = "Wrestling Matches";

    var search = Context.Request.Query["search"].ToString();
    var promotion = Context.Request.Query["promotion"].ToString();
    var sort = Context.Request.Query["sort"].ToString();

    var promotions = Model
        .Where(m => !string.IsNullOrWhiteSpace(m.Promotion))
        .Select(m => m.Promotion!)
        .Distinct()
        .OrderBy(p => p)
        .ToList();
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
        <div>
            <h1 class="fw-bold text-white">Wrestling Matches</h1>
            <p class="text-secondary">
                Explore legendary wrestling matches from around the world.
            </p>
        </div>

        <a asp-controller="Matches"
           asp-action="Create"
           class="btn btn-danger">
            + Add Match
        </a>
    </div>

    <!-- SEARCH AND FILTER -->
    <div class="card bg-dark text-white border-secondary mb-4">
        <div class="card-body p-4">

            <h4 class="fw-bold mb-3">
                Search & Filter Matches
            </h4>

            <form asp-controller="Matches"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-5">
                        <label class="form-label">Search Matches</label>

                        <input type="text"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Search matches or wrestlers..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Promotion</label>

                        <select name="promotion" class="form-select">
                            <option value="">All Promotions</option>

                            @foreach (var p in promotions)
                            {
                                <option value="@p"
                                        selected="@(promotion == p)">
                                    @p
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Sort By</label>

                        <select name="sort" class="form-select">

                            <option value="newest"
                                    selected="@(sort == "newest" || string.IsNullOrEmpty(sort))">
                                Newest First
                            </option>

                            <option value="oldest"
                                    selected="@(sort == "oldest")">
                                Oldest First
                            </option>

                            <option value="rating_high"
                                    selected="@(sort == "rating_high")">
                                Highest Rated
                            </option>

                            <option value="rating_low"
                                    selected="@(sort == "rating_low")">
                                Lowest Rated
                            </option>

                            <option value="title"
                                    selected="@(sort == "title")">
                                Match Title (A-Z)
                            </option>

                        </select>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-danger">
                        Apply Filters
                    </button>

                    <a asp-controller="Matches"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear Filters
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- MATCH RESULTS -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-white mb-0">
            Match Collection
        </h3>

        <span class="text-secondary">
            @Model.Count() matches found
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h3 class="text-white">No matches found</h3>
            <p class="text-secondary">
                Try changing your search or filters.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var match in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card bg-dark text-white border-secondary h-100 shadow overflow-hidden">

                        <!-- MATCH IMAGE -->
                        <div class="position-relative bg-black"
                             style="height: 250px;">

                            <!-- Fallback when image is missing -->
                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center text-secondary"
                                 style="background: linear-gradient(135deg, #25252b, #101014);">

                                <span style="font-size: 55px;">★</span>
                                <span class="fw-bold">MATCHVAULT</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(match.ImageUrl))
                            {
                                <img src="@match.ImageUrl"
                                     alt="@match.Title"
                                     loading="lazy"
                                     onerror="this.style.display='none'"
                                     class="position-relative w-100 h-100"
                                     style="object-fit: cover;" />
                            }

                            @if (match.Rating.HasValue)
                            {
                                <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3"
                                      style="z-index: 2;">
                                    ★ @match.Rating.Value.ToString("0.0") / 10
                                </span>
                            }
                        </div>

                        <!-- MATCH INFORMATION -->
                        <div class="card-body p-4 d-flex flex-column">

                            <h4 class="fw-bold mb-2">
                                @match.Title
                            </h4>

                            <p class="text-danger fw-bold mb-3">
                                @match.Wrestler1 vs. @match.Wrestler2
                            </p>

                            @if (!string.IsNullOrWhiteSpace(match.Promotion))
                            {
                                <p class="text-secondary mb-2">
                                    <strong>Promotion:</strong>
                                    @match.Promotion
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(match.Event))
                            {
                                <p class="text-secondary mb-2">
                                    <strong>Event:</strong>
                                    @match.Event
                                </p>
                            }

                            <p class="text-secondary mb-2">
                                <strong>Date:</strong>
                                @match.MatchDate.ToString("MMMM dd, yyyy")
                            </p>

                            @if (!string.IsNullOrWhiteSpace(match.Winner))
                            {
                                <p class="text-secondary mb-3">
                                    <strong>Winner:</strong>
                                    <span class="text-success">
                                        @match.Winner
                                    </span>
                                </p>
                            }

                            <div class="mt-auto pt-3">
                                <a asp-controller="Matches"
                                   asp-action="Details"
                                   asp-route-id="@match.Id"
                                   class="btn btn-outline-danger w-100">
                                    View Match
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>
