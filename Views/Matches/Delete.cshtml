
@model MatchVault.Models.Match

@{
    ViewData["Title"] = "Delete Match";
}

<div class="container py-5">

    <h1 class="fw-bold text-white">Delete Wrestling Match</h1>

    <p class="text-danger mb-4">
        Are you sure you want to delete this match?
        This action cannot be undone.
    </p>

    <div class="card bg-dark text-white border-secondary">
        <div class="card-body p-4">

            <h3 class="fw-bold">@Model.Title</h3>

            <p class="text-danger fw-bold">
                @Model.Wrestler1 vs. @Model.Wrestler2
            </p>

            <p>
                <strong>Promotion:</strong>
                @Model.Promotion
            </p>

            <p>
                <strong>Event:</strong>
                @Model.Event
            </p>

            <p>
                <strong>Date:</strong>
                @Model.MatchDate.ToString("MMMM dd, yyyy")
            </p>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Yes, Delete Match
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </form>
        </div>
    </div>
</div>
