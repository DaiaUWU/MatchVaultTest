
@model MatchVault.Models.Match

@{
    ViewData["Title"] = "Edit Match";
}

<div class="container py-5">

    <h1 class="fw-bold text-white">Edit Wrestling Match</h1>
    <p class="text-secondary mb-4">
        Update match information.
    </p>

    <div class="card bg-dark text-white border-secondary">
        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Wrestler1" class="form-label"></label>
                        <input asp-for="Wrestler1" class="form-control" />
                        <span asp-validation-for="Wrestler1" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Wrestler2" class="form-label"></label>
                        <input asp-for="Wrestler2" class="form-control" />
                        <span asp-validation-for="Wrestler2" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="EventId" class="form-label">
                        Wrestling Event
                    </label>
                    <select asp-for="EventId"
                            asp-items="ViewBag.Events"
                            class="form-select">
                        <option value="">No linked event</option>
                    </select>
                    <span asp-validation-for="EventId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Promotion" class="form-label"></label>
                        <input asp-for="Promotion" class="form-control" />
                        <span asp-validation-for="Promotion" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MatchDate" class="form-label"></label>
                        <input asp-for="MatchDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="MatchDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Event" class="form-label"></label>
                    <input asp-for="Event" class="form-control" />
                    <span asp-validation-for="Event" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MatchType" class="form-label"></label>
                    <input asp-for="MatchType" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Winner" class="form-label"></label>
                    <input asp-for="Winner" class="form-control" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DurationMinutes" class="form-label"></label>
                        <input asp-for="DurationMinutes"
                               type="number"
                               min="0"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Rating" class="form-label"></label>
                        <input asp-for="Rating"
                               type="number"
                               min="0"
                               max="10"
                               step="0.1"
                               class="form-control" />
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label"></label>
                    <input asp-for="ImageUrl" class="form-control" />
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"></textarea>
                </div>

                <button type="submit" class="btn btn-danger">
                    Save Changes
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
