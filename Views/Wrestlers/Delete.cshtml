
@model MatchVault.Models.Wrestler

@{
    ViewData["Title"] = "Delete Wrestler";
}

<div class="container py-5">

    <a asp-controller="Wrestlers"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-outline-secondary mb-4">
        ← Back to Wrestler
    </a>

    <h1 class="fw-bold mb-3">Delete Wrestler</h1>

    <p class="text-secondary mb-4">
        Are you sure you want to delete this wrestler?
    </p>

    <div class="card bg-dark text-white border-secondary shadow-lg">
        <div class="card-body p-4">

            <h2 class="fw-bold">@Model.Name</h2>

            <h5 class="text-danger mb-3">
                @Model.Promotion
            </h5>

            <p>
                <strong>Country:</strong> @Model.Country
            </p>

            <div class="alert alert-danger mt-4">
                Warning: This action cannot be undone.
            </div>

            <form asp-controller="Wrestlers"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete Wrestler
                </button>

                <a asp-controller="Wrestlers"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-light ms-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>
