
@model MatchVault.Models.Wrestler

@{
    ViewData["Title"] = "Edit Wrestler";
}

<div class="container py-5">

    <h1 class="fw-bold text-white">Edit Wrestler</h1>
    <p class="text-secondary mb-4">
        Update wrestler information in MatchVault.
    </p>

    <div class="card bg-dark text-white border-secondary shadow-lg">
        <div class="card-body p-4">

            <form asp-controller="Wrestlers"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Country" class="form-label"></label>
                        <input asp-for="Country" class="form-control" />
                        <span asp-validation-for="Country"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Promotion" class="form-label"></label>
                        <input asp-for="Promotion" class="form-control" />
                        <span asp-validation-for="Promotion"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="DebutDate" class="form-label">
                        Debut Date
                    </label>
                    <input asp-for="DebutDate"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="DebutDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label">
                        Profile Image URL
                    </label>
                    <input asp-for="ImageUrl" class="form-control" />
                    <span asp-validation-for="ImageUrl"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Biography" class="form-label"></label>
                    <textarea asp-for="Biography"
                              class="form-control"
                              rows="5"></textarea>
                    <span asp-validation-for="Biography"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        Save Changes
                    </button>

                    <a asp-controller="Wrestlers"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
