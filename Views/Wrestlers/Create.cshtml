
@model MatchVault.Models.Wrestler

@{
    ViewData["Title"] = "Add Wrestler";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold text-white">Add Wrestler</h1>
        <p class="text-secondary">
            Add a professional wrestler to MatchVault.
        </p>
    </div>

    <div class="card bg-dark text-white border-secondary shadow-lg">
        <div class="card-body p-4">

            <form asp-controller="Wrestlers"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. Cody Rhodes" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Country" class="form-label"></label>
                        <input asp-for="Country"
                               class="form-control"
                               placeholder="e.g. United States" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Promotion" class="form-label"></label>
                        <input asp-for="Promotion"
                               class="form-control"
                               placeholder="e.g. WWE" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="DebutDate" class="form-label">
                        Debut Date
                    </label>
                    <input asp-for="DebutDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label">
                        Profile Image URL
                    </label>
                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="https://example.com/wrestler.jpg" />
                </div>

                <div class="mb-4">
                    <label asp-for="Biography" class="form-label"></label>
                    <textarea asp-for="Biography"
                              class="form-control"
                              rows="5"
                              placeholder="Write a short biography..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        Save Wrestler
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
