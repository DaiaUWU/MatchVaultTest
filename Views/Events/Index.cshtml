
@model IEnumerable<MatchVault.Models.Event>

@{
    ViewData["Title"] = "Wrestling Events";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-white">Wrestling Events</h1>
            <p class="text-secondary">
                Explore wrestling events from around the world.
            </p>
        </div>

        <a asp-controller="Events"
           asp-action="Create"
           class="btn btn-danger">
            + Add Event
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h3 class="text-white">No events yet</h3>
            <p class="text-secondary">
                Start building your wrestling event collection.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card bg-dark text-white h-100">

                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 class="card-img-top"
                                 alt="@item.Name"
                                 style="height:250px;object-fit:cover;" />
                        }

                        <div class="card-body">
                            <h4 class="fw-bold">@item.Name</h4>

                            <p class="text-danger fw-bold">
                                @item.Promotion
                            </p>

                            <p class="text-secondary">
                                @item.EventDate.ToString("MMMM dd, yyyy")
                            </p>

                            <p class="text-secondary">
                                @item.Location
                            </p>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-danger">
                                View Event
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
