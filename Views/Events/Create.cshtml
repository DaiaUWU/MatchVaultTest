
@model MatchVault.Models.Event

@{
    ViewData["Title"] = "Add Event";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold text-white">Add Wrestling Event</h1>
        <p class="text-secondary">
            Add a new wrestling event to MatchVault.
        </p>
    </div>

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-4">

            <form asp-controller="Events"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. WrestleMania 40" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Promotion" class="form-label"></label>
                    <select asp-for="Promotion" class="form-select">
                        <option value="">Select Promotion</option>
                        <option value="WWE">WWE</option>
                        <option value="AEW">AEW</option>
                        <option value="NJPW">NJPW</option>
                        <option value="TNA">TNA</option>
                        <option value="ROH">ROH</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Promotion"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="EventDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Venue" class="form-label"></label>
                    <input asp-for="Venue"
                           class="form-control"
                           placeholder="e.g. Lincoln Financial Field" />
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location"
                           class="form-control"
                           placeholder="e.g. Philadelphia, USA" />
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label"></label>
                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="https://example.com/poster.jpg" />
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the event..."></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-danger">
                        Save Event
                    </button>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-outline-light">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
