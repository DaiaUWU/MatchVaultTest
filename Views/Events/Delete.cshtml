
@model MatchVault.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container py-5">
    <h1 class="fw-bold text-danger">Delete Event</h1>
    <p class="text-secondary">
        Are you sure you want to delete this wrestling event?
    </p>

    <div class="card bg-dark text-white border-secondary p-4">
        <h3 class="fw-bold">@Model.Name</h3>
        <p class="text-danger fw-bold">@Model.Promotion</p>

        <p>
            <strong>Date:</strong>
            @Model.EventDate.ToString("MMMM dd, yyyy")
        </p>

        <p><strong>Venue:</strong> @Model.Venue</p>
        <p><strong>Location:</strong> @Model.Location</p>

        <div class="alert alert-warning mt-3">
            Warning: This action cannot be undone.
        </div>

        <form asp-controller="Events" asp-action="Delete"
              asp-route-id="@Model.Id" method="post">

            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                Yes, Delete Event
            </button>

            <a asp-action="Details" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary ms-2">
                Cancel
            </a>
        </form>
    </div>
</div>
